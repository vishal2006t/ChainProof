# ==============================================================
# ChainProof Backend API Configuration
# ==============================================================

# Port the Express API server listens on
PORT=5000

# JSON Web Token Secret (Change to a cryptographically secure random string in production)
JWT_SECRET=chainproof_dev_jwt_secret_do_not_use_in_prod_8923489234
JWT_EXPIRES_IN=24h

# Blockchain RPC Node URL (Default: Hardhat local node on port 8545)
RPC_URL=http://127.0.0.1:8545

# Deployed CertificateRegistry Smart Contract Address
# This will be automatically populated from deployed-contract.json if left blank
CONTRACT_ADDRESS=0x5FbDB2315678afecb367f032d93F642f64180aa3

# SQLite Database File Path (Default: ./chainproof.db)
DATABASE_PATH=./chainproof.db

# Frontend CORS Origin Allowed by Backend
CORS_ORIGIN=http://localhost:5173

# Hardhat Local Node Signing Keys (DEV ONLY — NEVER USE IN PRODUCTION OR WITH REAL FUNDS)
# Admin (Account #0): 0xf39Fd6e51aad88F6F4ce6aB8827279cffFb92266
ADMIN_PRIVATE_KEY=0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80

# Demo Issuer - Apex State University (Account #1): 0x70997970C51812dc3A010C7d01b50e0d17dc79C8
DEMO_ISSUER_PRIVATE_KEY=0x59c6995e998f97a5a0044966f0945389dc9e86dae88c7a8412f4603b6b78690d
